{
	"name": "directus-extension-signed-files",
	"description": "Issue short-lived, authenticated download links for Directus files.",
	"icon": "extension",
	"version": "1.1.0",
	"license": "GPL-3.0-only",
	"keywords": [
		"directus",
		"directus-extension",
		"directus-extension-endpoint"
	],
	"type": "module",
	"files": [
		"dist"
	],
	"directus:extension": {
		"type": "endpoint",
		"path": "dist/index.js",
		"source": "src/index.ts",
		"host": "^10.10.0"
	},
	"scripts": {
		"build": "directus-extension build",
		"dev": "directus-extension build -w --no-minify",
		"link": "directus-extension link",
		"validate": "directus-extension validate"
	},
	"devDependencies": {
		"@directus/extensions-sdk": "^18.0.6",
		"@types/express": "^5.0.6",
		"@types/node": "^26.6.5",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@directus/errors": "^3.0.0"
	}
}
